{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "slbm_tracker.api.app:app", "--host", "127.0.0.1", "--port", "8010"],
      "port": 8010
    },
    {
      "name": "frontend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "VITE_BACKEND_TARGET=http://127.0.0.1:8010 npm --prefix frontend run dev -- --port 5180 --strictPort"],
      "port": 5180
    }
  ]
}
