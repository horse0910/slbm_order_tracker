# Frontend configuration (Vite). Copy to `.env` to override defaults.

# Base URL for the FastAPI backend. Leave empty to use same-origin + the Vite
# dev proxy (recommended for local dev). Set to e.g. http://127.0.0.1:8000 to
# talk to the backend directly.
VITE_API_BASE_URL=

# Override the dev proxy target (defaults to http://127.0.0.1:8000).
# VITE_BACKEND_TARGET=http://127.0.0.1:8000

# Polling interval for the Live SLB view, in milliseconds (default 15000).
VITE_POLL_INTERVAL_MS=15000
