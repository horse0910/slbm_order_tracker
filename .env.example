# Database Configuration
DATABASE_URL=sqlite:///./slbm_tracker.db

# NSE Configuration (Configurable & Replaceable if NSE changes endpoints)
NSE_BASE_URL=https://www.nseindia.com
NSE_SLB_API_URL=https://www.nseindia.com/api/slb-data
NSE_SLB_PAGE_URL=https://www.nseindia.com/market-data/securities-lending-and-borrowing
NSE_ALL_REPORTS_URL=https://www.nseindia.com/all-reports
NSE_REQUEST_TIMEOUT_SECONDS=10.0
NSE_MAX_RETRIES=3
NSE_RATE_LIMIT_DELAY_SECONDS=2.0

# Fee and Yield Defaults
DEFAULT_ALERT_YIELD_THRESHOLD=8.0
BROKER_PROCESSING_FEE_PCT=20.0
GST_PCT=18.0
DP_CHARGE_PCT=0.02

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Email / SMTP Alert Delivery (Phase 5A) — ENV-ONLY SECRETS.
# These are read from the environment / .env ONLY. They are never stored in the
# database, never returned by any API response, and never editable from the UI.
# Email delivery stays OFF until BOTH SMTP_HOST and ALERT_EMAIL_TO are set (and
# NOTIFICATIONS_ENABLED is true). In-app delivery works regardless. Leave blank
# to keep the email channel disabled.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true
# SMTP_FROM_ADDR=you@example.com
# ALERT_EMAIL_TO=alerts-recipient@example.com
